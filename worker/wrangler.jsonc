{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "modal-notebook-studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "vars": {
    "DENO_API_ORIGIN": "https://modal-notebook-studio.manan.deno.net"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health", "/studio-config.js"]
  }
}
