# The per-user controller listens on localhost. The shared Worker is static and
# connects to this helper from the browser; no public API tunnel is required.
APP_PASSWORD=replace-with-a-long-random-password
HOST=127.0.0.1
PORT=8000
APP_ALLOWED_ORIGINS=https://modal-notebook-studio-staging.bhansalimanan55.workers.dev

MODAL_ENABLED=false
MODAL_APP_NAME=personal-notebook-studio
MODAL_VOLUME_NAME=personal-notebook-studio-workspace

# App-side estimate guard only. Set to the compute amount you choose to allow.
MONTHLY_COMPUTE_BUDGET_USD=30
BUDGET_SAFETY_BUFFER_USD=1
MAX_SESSION_HOURS=8
DEFAULT_IDLE_TIMEOUT_MINUTES=15
UPLOAD_LIMIT_GIB=4
DATABASE_PATH=./data/studio.sqlite3
APP_PUBLIC=false

# Shared instance settings. Provision each friend with notebook-studio-user add.
MULTI_USER_MODE=false
MODAL_CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
ADMIN_PROVISIONING_KEY=
